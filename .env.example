# Copy to .env.local when application implementation begins.
# Create a key in a free-tier project at https://aistudio.google.com/apikey
# Server only: never prefix the key with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Verified against public documentation on 2026-10-13.
# Actual account access and remaining quota must be checked with a live sample.
GEMINI_MODEL=gemini-3.8-flash

# Relative to the application working directory; ignored by Git.
DATABASE_PATH=.data/consultnote.sqlite
