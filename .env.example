# Copy to .env.local, set your keys, then restart the app.
# Primary processing: AssemblyAI handles audio; Groq receives transcript text.
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=
TRANSCRIPTION_PROVIDER=assemblyai
GROQ_MODEL=openai/gpt-oss-120b

# Optional original transcription alternative: TRANSCRIPTION_PROVIDER=gemini.
# Create a key in a free-tier project at https://aistudio.google.com/apikey
# Server only: never prefix the key with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Verified against public documentation on 2026-10-13.
# Actual account access and remaining quota must be checked with a live sample.
# Uses the Interactions API; there is no automatic model fallback.
GEMINI_MODEL=gemini-3.8-flash

# Relative to the application working directory; ignored by Git.
DATABASE_PATH=.data/consultnote.sqlite

# Optional cloud mode. Set all three after following docs/deployment.md.
# Public keys identify your project; RLS protects each user's data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this secret with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy alternative, only if your project still uses it:
# SUPABASE_SERVICE_ROLE_KEY=
