# Supabase setup for running the full app locally or on Vercel.
# Copy to .env.local, fill in your own credentials, then restart the app.
# Apply all supabase/migrations first; see docs/deployment.md.
# No working credentials are included in this template.

# Required: AssemblyAI transcribes audio; Groq prepares speaker labels and notes.
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=
TRANSCRIPTION_PROVIDER=assemblyai
GROQ_MODEL=openai/gpt-oss-120b

# Required: Supabase accounts, profiles, consultations and private audio storage.
# Copy your project URL and publishable key from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required server-only secret for processing and account deletion.
# Never prefix this key or the AI keys with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Local Auth redirects: http://127.0.0.1:3000/**
# On Vercel, add the required values in Project Settings > Environment Variables
# before building, and allow your deployment's Auth callback in Supabase.
# Do not add VERCEL_OIDC_TOKEN or a database password to this runtime file.

# Optional Gemini transcription alternative; Groq is still required for notes.
# Set TRANSCRIPTION_PROVIDER=gemini only when explicitly choosing Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional legacy Supabase server key, only if your project still uses it:
# SUPABASE_SERVICE_ROLE_KEY=
