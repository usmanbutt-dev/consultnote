# Optional Supabase CLI configuration for applying database migrations.
# Copy to .env.supabase only if you need to keep a local CLI password file.
# This file is not required to run the app and is not loaded automatically.
# The CLI needs SUPABASE_DB_PASSWORD in its shell environment, or you can
# enter the database password at the CLI prompt instead of creating this file.
# Use your own Supabase project's database password. Never commit the filled file.
SUPABASE_DB_PASSWORD=
